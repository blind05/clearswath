# Copy to .env and add your key. Never commit .env.
MODEL_API_KEY=paste-your-key-here
# Muse Spark Open on Baseten or Fireworks (optional). LLM_PROVIDER picks the default Spark: meta, baseten or fireworks.
BASETEN_API_KEY=paste-your-baseten-key-here
LLM_PROVIDER=meta
FIREWORKS_API_KEY=paste-your-fireworks-key-here
