# Copy to .env and add your key. Never commit .env.
MODEL_API_KEY=paste-your-key-here
# Muse Spark Open on Baseten or Fireworks. LLM_PROVIDER picks the Spark for the agent and records; LABEL_PROVIDER
# reads labels (falling back to LABEL_FALLBACK_PROVIDER). Each is meta, baseten or fireworks.
BASETEN_API_KEY=paste-your-baseten-key-here
FIREWORKS_API_KEY=paste-your-fireworks-key-here
LLM_PROVIDER=meta
AGENT_FALLBACK_PROVIDER=baseten
LABEL_PROVIDER=baseten
LABEL_FALLBACK_PROVIDER=meta
